DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/geopilot_ai?schema=public"
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="https://geopilotapp.com"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="GeoPilot AI <no-reply@geopilotapp.com>"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAxxxxxxxxxxxxxxx"
TURNSTILE_SECRET_KEY="0x4AAAAAAxxxxxxxxxxxxxxxxxxxxxxxx"
DEV_MODE="false"
# Real AI Search Provider keys remain server-side. Existing env:NAME references stay supported.
# Versioned AES-256-GCM keyring. Each value must be 32 random bytes encoded as base64 or 64 hex characters.
# The legacy variable is accepted only as a V1 fallback for credentials saved before key versioning.
PROVIDER_SECRET_ENCRYPTION_KEY=""
PROVIDER_SECRET_ENCRYPTION_KEY_V1=""
PROVIDER_SECRET_ENCRYPTION_KEY_V2=""
PROVIDER_SECRET_ACTIVE_KEY_VERSION="2"
# Preview: npm run provider-secrets:rotate -- --dry-run --batch-size=100
# Apply only after preview: npm run provider-secrets:rotate -- --apply --batch-size=100
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
PERPLEXITY_API_KEY=""
